diff --git a/kernel/sysproc.c b/kernel/sysproc.c
index cd25557..6751889 100644
--- a/kernel/sysproc.c
+++ b/kernel/sysproc.c
@@ -109,4 +109,56 @@ sys_uptime(void)
   xticks = ticks;
   release(&tickslock);
   return xticks;
+}
+   uint64
+   sys_set_burst(void)
+   {
+     int pid, bt;
+     
+     // In your version of xv6, argint returns void, so we just call it.
+     argint(0, &pid);
+     argint(1, &bt);
+
+     // Declare the proc array so this file can see it
+     extern struct proc proc[];
+     
+     struct proc *p;
+     for(p = proc; p < &proc[NPROC]; p++){
+       acquire(&p->lock);
+       if(p->pid == pid && p->state != UNUSED){
+         p->burst_time = bt;
+         p->remaining_time = bt;
+         release(&p->lock);
+         return 0;
+       }
+       release(&p->lock);
+     }
+     return -1;
+   }
+
+// Shared memory syscall for Assignment 5
+// Allocates a physical page and maps it to user space at 0x30000000
+uint64
+sys_shm_get(void)
+{
+  static char *shared_mem = 0;
+  
+  // Allocate shared page only once
+  if(shared_mem == 0){
+    shared_mem = kalloc();
+    if(shared_mem == 0) return -1;
+    memset(shared_mem, 0, PGSIZE);
+  }
+  
+  struct proc *p = myproc();
+  uint64 va = 0x30000000; // Fixed user virtual address
+  
+  // Check if already mapped (inherited after fork)
+  pte_t *pte = walk(p->pagetable, va, 0);
+  if(pte == 0 || (*pte & PTE_V) == 0){
+    if(mappages(p->pagetable, va, PGSIZE, (uint64)shared_mem, PTE_R | PTE_W | PTE_U) < 0){
+      return -1;
+    }
+  }
+  return va;
 }
